rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Giáo án cá nhân — chỉ owner đọc/ghi, cộng đồng đọc khi isPublic=true
    match /lessonPlans/{planId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Mẫu giáo án cá nhân
    match /userTemplates/{templateId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Cài đặt người dùng — document id = uid
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Phân phối chương trình
    match /distributions/{distId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Bài học phân hoá — giáo viên ghi; học sinh chỉ đọc khi giáo viên bật cổng học sinh
    match /adaptiveLessons/{teacherId} {
      allow read: if (request.auth != null && request.auth.uid == teacherId)
                  || resource.data.portalEnabled == true;
      allow create: if request.auth != null
                    && request.auth.uid == teacherId
                    && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
                    && request.auth.uid == teacherId
                    && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null
                    && request.auth.uid == teacherId
                    && request.auth.uid == resource.data.userId;
    }

    // Tiến trình từng tiết học phân hoá — học sinh ghi theo mã học sinh; giáo viên owner quản trị được
    match /adaptiveSessionProgress/{progressId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.teacherId;
      allow create: if request.resource.data.teacherId is string
                    && request.resource.data.studentId is string
                    && request.resource.data.studentCode is string;
      allow update: if request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.studentCode == resource.data.studentCode;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
    }

    // Hồ sơ học tập dài hạn — MVP cho phép học sinh đọc/ghi bằng link + mã học sinh; bản sau sẽ siết bằng tài khoản học sinh
    match /studentLearningProfiles/{studentId} {
      allow read: if request.auth != null
                  || resource.data.studentId == studentId;
      allow create: if request.resource.data.teacherId is string
                    && request.resource.data.studentId == studentId
                    && request.resource.data.studentCode is string;
      allow update: if request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.studentCode == resource.data.studentCode;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
    }

    // === CHỨC NĂNG THI ONLINE ===

    // Đề thi — học sinh đọc khi đã phát hành; chỉ giáo viên chủ đề được ghi
    match /exams/{examId} {
      allow read: if resource.data.isActive == true
                  || (request.auth != null && request.auth.uid == resource.data.teacherId);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.teacherId;
    }

    // Bài làm học sinh
    //  - create: ai cũng tạo được (học sinh nặc danh)
    //  - update: chỉ khi bài còn 'in_progress' (không sửa được sau khi nộp)
    //  - read: chỉ giáo viên chủ đề đọc được
    match /examSubmissions/{subId} {
      allow create: if request.resource.data.status == 'in_progress';
      allow update: if resource.data.status == 'in_progress';
      allow read: if request.auth != null
                  && request.auth.uid == get(/databases/$(database)/documents/exams/$(resource.data.examId)).data.teacherId;
    }

    // Telemetry fallback — học sinh/cổng anonymous được tạo event tối thiểu; giáo viên owner đọc để theo dõi tỷ lệ lưu.
    match /fallbackEvents/{eventId} {
      allow create: if request.resource.data.teacherId is string
                    && request.resource.data.studentId is string
                    && request.resource.data.lessonId is string
                    && request.resource.data.stage in ['api', 'firestore', 'localStorage']
                    && request.resource.data.timestamp is string
                    && request.resource.data.errorMessage is string;
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.teacherId;
    }
  }
}
