rules_version = '2';
// Deploy: firebase deploy --only firestore:rules,firestore:indexes
// Cần Firebase CLI: npm install -g firebase-tools && firebase login

service cloud.firestore {
  match /databases/{database}/documents {

    // Giáo án cá nhân — chỉ owner đọc/ghi, cộng đồng đọc khi isPublic=true
    match /lessonPlans/{planId} {
      allow list: if request.auth != null;
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Mẫu giáo án cá nhân
    match /userTemplates/{templateId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Cài đặt người dùng — document id = uid
    match /userSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Phân phối chương trình
    match /distributions/{distId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Bài học phân hoá — service lưu document theo lesson.id, owner nằm trong field teacherId
    match /adaptiveLessons/{lessonId} {
      // Đọc: giáo viên đã đăng nhập đọc được (listLessonsForTeacher query theo field teacherId).
      // Học sinh ẩn danh đọc được CHỈ KHI bài đã bật cổng (portalEnabled == true) — link cổng là công khai.
      allow read: if request.auth != null
                  || resource.data.get('portalEnabled', false) == true;
      // Tạo: chỉ khi teacherId trong document trùng với uid người tạo
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherId;
      // Sửa/Xóa: chỉ owner bài
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
    }

    // Cache kết quả sinh lộ trình AI (Task 2)
    match /personalizationCache/{cacheId} {
      // Cho phép giáo viên và học sinh nặc danh đọc/ghi cache
      allow read, write: if true;
    }

    // Tiến trình từng tiết học phân hoá — ưu tiên API Admin; client nặc danh chỉ là kênh fallback có kiểm tra định danh/link bài học.
    match /adaptiveSessionProgress/{progressId} {
      function adaptiveLessonDoc(teacherId) {
        return get(/databases/$(database)/documents/adaptiveLessons/$(teacherId));
      }
      function activePortalForLesson(teacherId, lessonId) {
        return adaptiveLessonDoc(teacherId).data.portalEnabled == true
               && adaptiveLessonDoc(teacherId).data.lesson.id == lessonId;
      }
      function validProgressIdentity(data) {
        return data.id == progressId
               && data.teacherId is string
               && data.teacherId.size() > 0
               && data.teacherId.size() <= 128
               && data.lessonId is string
               && data.lessonId.size() > 0
               && data.lessonId.size() <= 128
               && data.studentId is string
               && data.studentId.size() > 0
               && data.studentId.size() <= 256
               && data.studentCode is string
               && data.studentCode.size() > 0
               && data.studentCode.size() <= 64
               && data.studentId == data.teacherId + '_' + data.studentCode
               && progressId == data.teacherId + '_' + data.lessonId + '_' + data.studentCode;
      }
      function validProgressShape(data) {
        return data.lessonTitle is string
               && data.lessonTitle.size() <= 300
               && data.studentName is string
               && data.studentName.size() > 0
               && data.studentName.size() <= 120
               && (!('studentClass' in data) || data.studentClass is string)
               && data.route in ['foundation', 'standard', 'challenge']
               && data.status in ['in_progress', 'needs_support', 'completed']
               && data.diagnosticAttempt is map
               && data.quickCheckAttempts is list
               && data.quickCheckAttempts.size() <= 20
               && data.objectiveStates is list
               && data.objectiveStates.size() <= 80
               && data.remediationAttempts is number
               && (!('completedUnitIds' in data) || data.completedUnitIds is list)
               && (!('uploadedImageUrls' in data) || data.uploadedImageUrls is list)
               && data.startedAt is string
               && data.updatedAt is string
               && (!('completedAt' in data) || data.completedAt is string);
      }
      function validAnonymousProgressWrite(data) {
        return request.auth == null
               && validProgressIdentity(data)
               && validProgressShape(data)
               && activePortalForLesson(data.teacherId, data.lessonId);
      }

      allow read: if request.auth != null
                  && request.auth.uid == resource.data.teacherId;
      allow create: if validAnonymousProgressWrite(request.resource.data);
      allow update: if (request.auth != null && request.auth.uid == resource.data.teacherId)
                    || (validAnonymousProgressWrite(request.resource.data)
                        && request.resource.data.teacherId == resource.data.teacherId
                        && request.resource.data.lessonId == resource.data.lessonId
                        && request.resource.data.studentId == resource.data.studentId
                        && request.resource.data.studentCode == resource.data.studentCode);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
    }

    // Hồ sơ học tập dài hạn — chỉ giáo viên đọc; học sinh ghi qua API Admin, client nặc danh chỉ fallback có kiểm tra định danh/link bài học.
    match /studentLearningProfiles/{studentId} {
      function adaptiveLessonDoc(teacherId) {
        return get(/databases/$(database)/documents/adaptiveLessons/$(teacherId));
      }
      function activePortalForLastLesson(data) {
        return data.lastLessonId is string
               && adaptiveLessonDoc(data.teacherId).data.portalEnabled == true
               && adaptiveLessonDoc(data.teacherId).data.lesson.id == data.lastLessonId;
      }
      function validProfileIdentity(data) {
        return data.id == studentId
               && data.teacherId is string
               && data.teacherId.size() > 0
               && data.teacherId.size() <= 128
               && data.studentId == studentId
               && data.studentId is string
               && data.studentId.size() > 0
               && data.studentId.size() <= 256
               && data.studentCode is string
               && data.studentCode.size() > 0
               && data.studentCode.size() <= 64
               && studentId == data.teacherId + '_' + data.studentCode;
      }
      function validProfileShape(data) {
        return data.studentName is string
               && data.studentName.size() > 0
               && data.studentName.size() <= 120
               && (!('studentClass' in data) || data.studentClass is string)
               && data.totalSessions is number
               && data.averageMastery is number
               && data.routeHistory is list
               && data.routeHistory.size() <= 20
               && data.objectiveMemory is list
               && data.objectiveMemory.size() <= 80
               && data.misconceptionCounts is map
               && (!('lastLessonTitle' in data) || data.lastLessonTitle is string)
               && data.lastActiveAt is string
               && data.createdAt is string
               && data.updatedAt is string;
      }
      function validAnonymousProfileWrite(data) {
        return request.auth == null
               && validProfileIdentity(data)
               && validProfileShape(data)
               && activePortalForLastLesson(data);
      }

      allow read: if request.auth != null
                  && request.auth.uid == resource.data.teacherId;
      allow create: if validAnonymousProfileWrite(request.resource.data);
      allow update: if (request.auth != null && request.auth.uid == resource.data.teacherId)
                    || (validAnonymousProfileWrite(request.resource.data)
                        && request.resource.data.teacherId == resource.data.teacherId
                        && request.resource.data.studentId == resource.data.studentId
                        && request.resource.data.studentCode == resource.data.studentCode);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.teacherId;
    }

    // === CHỨC NĂNG THI ONLINE ===

    // Đề thi — CHỈ giáo viên chủ đề đọc trực tiếp (doc chứa đáp án).
    // Học sinh KHÔNG đọc doc này; đề đã lược đáp án được phục vụ qua hàm serverless
    // /api/exam-public (admin SDK) để chống xem đáp án qua DevTools.
    match /exams/{examId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.teacherId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.teacherId;
    }

    // Đề thi đã lưu (favorites) — chỉ owner
    match /savedExams/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // Bài làm học sinh
    //  - create: học sinh nặc danh được tạo bài in_progress với id khó đoán do client sinh
    //  - update: học sinh nặc danh chỉ được sửa bài khi còn in_progress và không đổi định danh bài/đề
    //  - teacher: giáo viên chủ đề được đọc/chấm/cập nhật bài thuộc đề của mình
    //  - read public: chỉ cho đọc bài đã nộp/chấm theo link kết quả có subId khó đoán; không list được nếu query có thể chứa in_progress
    match /examSubmissions/{subId} {
      function examDoc(examId) {
        return get(/databases/$(database)/documents/exams/$(examId));
      }
      function isExamTeacher(examId) {
        return request.auth != null && request.auth.uid == examDoc(examId).data.teacherId;
      }
      function keepsSubmissionIdentity() {
        return request.resource.data.id == resource.data.id
               && request.resource.data.examId == resource.data.examId
               && request.resource.data.examCode == resource.data.examCode
               && request.resource.data.studentName == resource.data.studentName
               && request.resource.data.studentClass == resource.data.studentClass
               && request.resource.data.startedAt == resource.data.startedAt
               && request.resource.data.maxScore == resource.data.maxScore
               && request.resource.data.clientNonce == resource.data.clientNonce;
      }
      function validStudentCreate() {
        return request.resource.data.id == subId
               && request.resource.data.status == 'in_progress'
               && request.resource.data.examId is string
               && request.resource.data.examCode is string
               && request.resource.data.studentName is string
               && request.resource.data.studentName.size() > 0
               && request.resource.data.studentName.size() <= 120
               && (!('studentClass' in request.resource.data) || request.resource.data.studentClass is string)
               && request.resource.data.startedAt is string
               && request.resource.data.answers is list
               && request.resource.data.maxScore is number
               && request.resource.data.tabSwitches is number
               && request.resource.data.clientNonce is string
               && request.resource.data.clientNonce.size() >= 24
               && examDoc(request.resource.data.examId).data.isActive == true
               && examDoc(request.resource.data.examId).data.code == request.resource.data.examCode;
      }
      function validStudentUpdate() {
        // Học sinh KHÔNG được tự set 'graded' (chỉ giáo viên/AI đặt); totalScore kẹp 0..maxScore.
        // Điểm học sinh ghi vẫn là client-computed — trang theo dõi của giáo viên sẽ tự xác minh
        // và tính lại từ đáp án gốc (verifySubmissionScore) mỗi lần mở.
        return resource.data.status == 'in_progress'
               && keepsSubmissionIdentity()
               && request.resource.data.status in ['in_progress', 'submitted']
               && request.resource.data.answers is list
               && (!('submittedAt' in request.resource.data) || request.resource.data.submittedAt is string)
               && (!('totalScore' in request.resource.data)
                   || (request.resource.data.totalScore is number
                       && request.resource.data.totalScore >= 0
                       && request.resource.data.totalScore <= resource.data.maxScore))
               && (!('tabSwitches' in request.resource.data) || request.resource.data.tabSwitches is number);
      }

      allow create: if validStudentCreate();
      allow update: if isExamTeacher(resource.data.examId) || validStudentUpdate();
      allow read: if isExamTeacher(resource.data.examId) || resource.data.status in ['submitted', 'graded'];
      allow delete: if isExamTeacher(resource.data.examId);
    }

    // Telemetry fallback — chỉ ghi schema tối thiểu đã redact PII; giáo viên owner đọc để theo dõi tỷ lệ lưu.
    match /fallbackEvents/{eventId} {
      function activePortalForTelemetry() {
        return get(/databases/$(database)/documents/adaptiveLessons/$(request.resource.data.teacherId)).data.portalEnabled == true
               && get(/databases/$(database)/documents/adaptiveLessons/$(request.resource.data.teacherId)).data.lesson.id == request.resource.data.lessonId;
      }
      allow create: if request.auth == null
                    && request.resource.data.keys().hasOnly(
                      ['teacherId', 'studentId', 'lessonId', 'stage', 'timestamp', 'errorCode', 'source'])
                    && request.resource.data.teacherId is string
                    && request.resource.data.teacherId.size() > 0
                    && request.resource.data.teacherId.size() <= 128
                    && request.resource.data.studentId is string
                    && request.resource.data.studentId.size() > 0
                    && request.resource.data.studentId.size() <= 256
                    && request.resource.data.lessonId is string
                    && request.resource.data.lessonId.size() > 0
                    && request.resource.data.lessonId.size() <= 128
                    && request.resource.data.studentId.matches(request.resource.data.teacherId + '_[^/]{1,64}')
                    && request.resource.data.stage in ['api', 'firestore', 'localStorage']
                    && request.resource.data.timestamp is string
                    && request.resource.data.timestamp.size() <= 40
                    && request.resource.data.errorCode in ['network', 'permission_denied', 'quota_exceeded', 'not_found', 'invalid_argument', 'unauthenticated', 'unknown']
                    && request.resource.data.source == 'student_portal'
                    && activePortalForTelemetry();
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.teacherId;
      allow update, delete: if false;
    }
    match /lessonSimulations/{simulationId} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.html is string
                    && request.resource.data.html.size() < 200000
                    && request.resource.data.lessonId is string;
      allow read: if true;  // HTML đã sandbox iframe, public đọc được là an toàn
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }
    // Phiên chấm điểm AI — chỉ owner đọc/ghi
    match /gradingSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // ────────────────────────────────────────────────────────────────
    // External Tools Registry (V5 - Phase 2)
    // ────────────────────────────────────────────────────────────────
    match /externalTools/{toolId} {
      function isAdmin() {
        return request.auth != null
               && request.auth.token.admin == true;
      }
      function validExternalToolPayload(data) {
        return data.keys().hasOnly([
                 'toolId', 'title', 'description', 'url', 'sourceDomain', 'tags',
                 'heightPreset', 'sandboxPreset', 'status', 'createdAt', 'updatedAt'
               ])
               && data.toolId == toolId
               && data.toolId is string
               && data.toolId.size() > 0
               && data.toolId.size() <= 64
               && data.title is string
               && data.title.size() > 0
               && data.title.size() <= 160
               && data.description is string
               && data.description.size() <= 1000
               && data.url is string
               && data.url.matches('https://.*')
               && data.url.size() <= 2048
               && data.sourceDomain is string
               && data.sourceDomain.size() > 0
               && data.sourceDomain.size() <= 160
               && data.tags is list
               && data.tags.size() <= 30
               && data.heightPreset in ['compact', 'standard', 'large']
               && data.sandboxPreset in ['strict', 'geogebra', 'trustedExternal']
               && data.status in ['pending', 'active', 'disabled'];
      }

      // Client chỉ đọc được tool active; admin đọc toàn bộ để quản trị.
      allow get: if isAdmin() || resource.data.status == 'active';
      allow list: if isAdmin() || resource.data.status == 'active';

      // Chỉ admin có custom claim mới được ghi; service account/backend bypass rules.
      allow create: if isAdmin() && validExternalToolPayload(request.resource.data);
      allow update: if isAdmin()
                    && request.resource.data.toolId == resource.data.toolId
                    && validExternalToolPayload(request.resource.data);
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────
    // MODULE DỰ GIỜ — biên bản dự giờ theo khung Danielson
    // Mô hình sở hữu giống lessonPlans: ai đăng nhập cũng tự lập được
    // biên bản của mình, chỉ mình đọc; muốn chia sẻ thì bật isPublic.
    // ────────────────────────────────────────────────────────────────

    /* Giáo viên được dự giờ: chỉ có mặt khi người lập điền gvEmail để mời họ
       tự đánh giá (bước 5 của chu trình dự giờ phát triển).

       Đối chiếu theo EMAIL chứ không theo uid: người dự giờ biết email đồng
       nghiệp, không ai biết uid của ai. Làm theo uid thì phải có API tra cứu
       bằng Admin SDK — thêm một Vercel function và một đường rò rỉ thông tin
       (biết email nào đã có tài khoản) cho đúng một việc mà rules tự làm được.

       email_verified bắt buộc: token Google có sẵn cờ này, thiếu nó thì ai
       khai email gì cũng đọc được biên bản của người khác.
       Dùng get() với mặc định vì document cũ chưa có trường — đọc thẳng sẽ ném lỗi. */
    function laGiaoVienDuocDu() {
      return request.auth != null
             && request.auth.token.get('email_verified', false) == true
             && request.auth.token.get('email', '') != ''
             && resource.data.get('gvEmail', '') != ''
             && resource.data.get('gvEmail', '').lower() == request.auth.token.email.lower();
    }

    /* Giáo viên CHỈ được ghi đúng ô tự đánh giá. Không sửa được điểm, nhận xét
       hay bất cứ thứ gì của người dự giờ. */
    function chiSuaTuDanhGia() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['tuDanhGia', 'updatedAt', 'capNhatLuc']);
    }

    match /duGio/{bienBanId} {

      // KHÔNG dùng `allow list: if request.auth != null` như lessonPlans —
      // thế là mọi người đăng nhập đều liệt kê được biên bản riêng của người
      // khác. Ở đây mỗi document ứng viên phải tự thoả điều kiện, nên client
      // buộc phải lọc theo userId hoặc theo isPublic.
      allow list: if (request.auth != null && resource.data.userId == request.auth.uid)
                  || resource.data.isPublic == true
                  || laGiaoVienDuocDu();

      allow get: if resource.data.isPublic == true
                 || (request.auth != null && request.auth.uid == resource.data.userId)
                 || laGiaoVienDuocDu();

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasAll(
                         ['userId', 'ngay', 'bienBan', 'isPublic']);

      // Không cho đổi chủ sở hữu sau khi tạo.
      allow update: if (request.auth != null
                        && request.auth.uid == resource.data.userId
                        && request.resource.data.userId == resource.data.userId)
                    || (laGiaoVienDuocDu() && chiSuaTuDanhGia());

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ═══════════════════════════════════════════════════════════════════
    // LỚP HỌC — giao bài · học sinh nộp bài · hồ sơ học tập
    //
    // Danh tính học sinh KHÔNG phải tài khoản Google. Học sinh đăng nhập ẩn
    // danh, rồi server (Admin SDK) kiểm mã lớp + mã học sinh + PIN và ghi một
    // document `studentLinks/{uid}` gắn phiên đó với đúng một học sinh. Mọi
    // luật bên dưới hỏi document ấy để biết người gọi là ai.
    //
    // Ba thứ cố ý KHÔNG cho client chạm tới:
    //  1. `studentSecrets` chứa PIN (bản băm để đối chiếu + bản thô để giáo viên chủ lớp xem
    //     mã qua API) — rules chặn cả đọc lẫn ghi, chỉ Admin SDK (vốn bỏ qua rules) đụng vào
    //     được. Rules không giấu được từng trường, nên PIN phải nằm ở document riêng chứ
    //     không nằm chung với thông tin học sinh.
    //  2. `studentLinks` — client đọc được phiên của chính mình để biết mình
    //     là ai, nhưng không tự tạo được. Cho client ghi là cho nó tự nhận là
    //     bất kỳ học sinh nào.
    //  3. Điểm và nhận xét trong `submissions.grade` — học sinh sửa được bài
    //     nộp khi chưa chấm, nhưng không bao giờ chạm được vào điểm.
    //
    // Danh sách học sinh trong lớp KHÔNG mở cho người chưa đăng nhập, kể cả
    // khi biết mã lớp. Màn hình "chọn tên mình" lấy danh sách qua server sau
    // khi đã kiểm mã lớp — nếu mở ở đây thì ai có mã lớp cũng lấy được trọn
    // danh sách tên trẻ em.
    // ═══════════════════════════════════════════════════════════════════

    function laChuLop(classId) {
      return request.auth != null
             && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    function coLienKetHocSinh() {
      return request.auth != null
             && exists(/databases/$(database)/documents/studentLinks/$(request.auth.uid));
    }

    function lienKetHocSinh() {
      return get(/databases/$(database)/documents/studentLinks/$(request.auth.uid)).data;
    }

    function laHocSinh(studentId) {
      return coLienKetHocSinh() && lienKetHocSinh().studentId == studentId;
    }

    function thuocLop(classId) {
      return coLienKetHocSinh() && lienKetHocSinh().classId == classId;
    }

    // Phiên đăng nhập của học sinh. Chỉ server ghi, sau khi đã kiểm PIN.
    match /studentLinks/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      // list chấm trên từng document ứng viên → client buộc phải lọc theo teacherId.
      allow list: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow get: if (request.auth != null && resource.data.teacherId == request.auth.uid)
                 || thuocLop(classId);

      allow create: if request.auth != null
                    && request.resource.data.teacherId == request.auth.uid
                    && request.resource.data.keys().hasAll(['teacherId', 'name', 'joinCode']);

      // Không đổi chủ sở hữu sau khi tạo.
      allow update: if request.auth != null
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == resource.data.teacherId;

      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;

      match /students/{studentId} {
        allow get: if laChuLop(classId) || laHocSinh(studentId);
        allow list: if laChuLop(classId);
        allow create, update, delete: if laChuLop(classId);
      }

      // PIN: bản băm dùng đối chiếu đăng nhập + bản thô để máy chủ trả về khi giáo viên chủ lớp
      // xem mã. Client KHÔNG đọc/ghi được document này bằng mọi giá — chỉ Admin SDK vào được.
      match /studentSecrets/{studentId} {
        allow read, write: if false;
      }
    }

    match /assignments/{assignmentId} {
      // Học sinh nhận projection từ /api/classroom studentAssignments. Cho đọc document gốc
      // sẽ làm lộ answerKey/rubric vì Firestore rules không che được từng field.
      allow list, get: if request.auth != null && resource.data.teacherId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.teacherId == request.auth.uid
                    && laChuLop(request.resource.data.classId)
                    && request.resource.data.keys().hasAll(['teacherId', 'classId', 'title', 'type', 'isOpen'])
                    && (!('sourceText' in request.resource.data)
                        || (request.resource.data.sourceText is string && request.resource.data.sourceText.size() <= 60000))
                    && (!('sourceImageUrls' in request.resource.data)
                        || (request.resource.data.sourceImageUrls is list && request.resource.data.sourceImageUrls.size() <= 6))
                    && (!('gradingInstructions' in request.resource.data)
                        || (request.resource.data.gradingInstructions is string && request.resource.data.gradingInstructions.size() <= 6000))
                    && (!('attachments' in request.resource.data)
                        || (request.resource.data.attachments is list && request.resource.data.attachments.size() <= 12));

      allow update: if request.auth != null
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == resource.data.teacherId
                    && request.resource.data.classId == resource.data.classId
                    && (!('sourceText' in request.resource.data)
                        || (request.resource.data.sourceText is string && request.resource.data.sourceText.size() <= 60000))
                    && (!('sourceImageUrls' in request.resource.data)
                        || (request.resource.data.sourceImageUrls is list && request.resource.data.sourceImageUrls.size() <= 6))
                    && (!('gradingInstructions' in request.resource.data)
                        || (request.resource.data.gradingInstructions is string && request.resource.data.gradingInstructions.size() <= 6000));

      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Practice đi qua Admin SDK ở /api/grade-homework để tách public question khỏi private key.
    // Cấm client đọc/ghi trực tiếp cả ba collection: không thể lách API để lấy đáp án hoặc tự
    // sửa điểm formative.
    match /practiceSets/{setId} {
      allow read, write: if false;
    }

    match /practiceKeys/{setId} {
      allow read, write: if false;
    }

    match /practiceAttempts/{attemptId} {
      allow read, write: if false;
    }

    // Evidence canonical của skill chỉ do Admin/API ghi và đọc để rebuild summary.
    // Không đưa raw evidence vào studentProfiles vì học sinh được phép đọc summary của mình.
    match /studentSkillEvidence/{evidenceId} {
      allow read, write: if false;
    }

    match /submissions/{submissionId} {
      // Học sinh nộp bài: mọi trường định danh phải khớp phiên của chính mình,
      // và tuyệt đối không được kèm sẵn điểm.
      function hocSinhNopHopLe() {
        let d = request.resource.data;
        return coLienKetHocSinh()
               && d.keys().hasOnly([
                    'id', 'teacherId', 'classId', 'studentId', 'assignmentId', 'fileUrls',
                    'supplementOf', 'textContent', 'attachments', 'note', 'status', 'createdAt', 'updatedAt'
                  ])
               && d.id == submissionId
               && d.studentId == lienKetHocSinh().studentId
               && d.classId == lienKetHocSinh().classId
               && d.teacherId == lienKetHocSinh().teacherId
               && (d.assignmentId == null || d.assignmentId is string)
               && (!('supplementOf' in d)
                   || (d.supplementOf is string && d.supplementOf.size() <= 150))
               && d.status == 'submitted'
               && !('grade' in d)
               && d.fileUrls is list
               && d.fileUrls.size() >= 1
               && d.fileUrls.size() <= 12
               && (!('textContent' in d)
                   || (d.textContent is string && d.textContent.size() <= 60000))
               && (!('attachments' in d)
                   || (d.attachments is list && d.attachments.size() >= 1 && d.attachments.size() <= 12));
      }

      // Nộp lại khi chưa chấm: chỉ được đổi file và ghi chú, không đụng gì khác.
      function hocSinhNopLai() {
        return laHocSinh(resource.data.studentId)
               && resource.data.status == 'submitted'
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['fileUrls', 'textContent', 'attachments', 'note', 'updatedAt']);
      }

      // Học sinh nhận projection từ /api/classroom studentSubmissions để loại teacherNote/noteForTeacher;
      // Firestore rules không redaction theo field nên không cho đọc document gốc trực tiếp.
      allow list, get: if request.auth != null && resource.data.teacherId == request.auth.uid;

      allow create: if hocSinhNopHopLe()
                    || (request.auth != null && request.resource.data.teacherId == request.auth.uid);

      allow update: if hocSinhNopLai()
                    || (request.auth != null
                        && resource.data.teacherId == request.auth.uid
                        && request.resource.data.teacherId == resource.data.teacherId
                        && request.resource.data.studentId == resource.data.studentId);

      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Hồ sơ tích luỹ. Học sinh ĐỌC được phần của mình, không bao giờ ghi được —
    // đây là hồ sơ đánh giá năng lực, do giáo viên và máy chấm dựng nên.
    match /studentProfiles/{studentId} {
      allow get: if (request.auth != null && resource.data.teacherId == request.auth.uid)
                 || laHocSinh(studentId);
      allow list: if request.auth != null && resource.data.teacherId == request.auth.uid;

      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

  }
}
