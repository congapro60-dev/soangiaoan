{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["api/**/*.ts"],
  "exclude": ["api/**/*.test.ts", "api/**/__tests__/**", "node_modules"]
}
