{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/export-lesson.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/katex/dist/**"
    },
    "api/render-word.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/adaptive-progress.ts": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
