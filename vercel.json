{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/export-lesson.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/katex/dist/**"
    },
    "api/render-word.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/adaptive-progress.ts": {
      "maxDuration": 15,
      "memory": 512
    },
    "api/health/firebase-admin.ts": {
      "maxDuration": 10,
      "memory": 256
    },
    "api/gemini-relay.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
