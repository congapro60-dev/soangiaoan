{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "git reset --hard*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "firebase*": "deny",
      "vercel*": "deny",
      "npm publish*": "deny",
      "npm run deploy*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny"
    }
  }
}
